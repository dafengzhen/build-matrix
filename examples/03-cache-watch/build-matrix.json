{
  "matrix": {
    "dimensions": {}
  },
  "pipeline": {
    "stages": [
      {
        "id": "bundle",
        "tasks": [
          {
            "id": "bundle",
            "adapter": "shell",
            "options": {
              "command": "node",
              "args": ["build.ts"]
            },
            "cache": {
              "version": "example@1;node",
              "inputs": ["src", "build.ts"],
              "outputs": ["dist"]
            }
          }
        ]
      }
    ]
  }
}
